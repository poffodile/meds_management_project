<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="./vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory suffix="Test.php">./tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory suffix="Test.php">./tests/Feature</directory>
        </testsuite>
    </testsuites>
    <coverage>
        <include>
            <directory suffix=".php">./app</directory>
        </include>
    </coverage>
    <php>
        <!-- The suite outgrew PHP's 128M default.
             Direct phpunit finished at exactly 128.00 MB — right on the line —
             and `php artisan test`, which wraps the run in its own process and
             reporter, tipped over it when Section 2.7 took the Record7 suite
             from 590 tests to 690. Nothing leaks; there is simply more of it.
             512M gives both runners room, so the two agree again. -->
        <ini name="memory_limit" value="512M"/>
        <env name="APP_ENV" value="testing"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_DRIVER" value="array"/>
        <!-- Tests run against a SEPARATE database (a clone of `laravel`), never the live one.
             Some existing tests use RefreshDatabase, which runs migrate:fresh and would
             otherwise DROP the working database. force="true" so this wins over .env.
             Re-clone with:  mysqldump laravel | mysql laravel_test  -->
        <env name="DB_DATABASE" value="laravel_test" force="true"/>
        <!-- Record7 keeps its own database, and its tests keep their own copy of it. -->
        <env name="RECORD7_DB_DATABASE" value="record7_test" force="true"/>
        <env name="RECORD7_MFA_MODE" value="test" force="true"/>
        <env name="RECORD7_ALLOW_PROTOTYPE_MFA" value="true" force="true"/>
        <env name="RECORD7_PROTOTYPE_MFA_CODE" value="246810" force="true"/>
        <env name="RECORD7_ALLOW_FIXTURE_SEED" value="true" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="APP_URL" value="http://localhost"/>
    </php>
</phpunit>
